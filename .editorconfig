root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{pbxproj,pbxuser,xcworkspacedata,plist,xcscheme}]
indent_size = tab
indent_style = tab

[Podfile]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf
