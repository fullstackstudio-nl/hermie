# Dependencies
node_modules/

# Build output
dist/
coverage/
*.tsbuildinfo

# Expo / continuous native generation — regenerate with `npx expo prebuild`
.expo/
apps/hermie/ios/
apps/hermie/android/

# Gradle's output for the local Expo modules, whose `android/` IS committed —
# so unlike the generated project above, only the build directories go.
apps/hermie/modules/*/android/build/
apps/hermie/modules/*/android/.gradle/
apps/hermie/modules/*/android/.cxx/

# Xcode build products, including the wrapped Mac bundle `npm run mac` writes
DerivedData/
apps/hermie/build/

# Screenshots from a simulator QA walk. Evidence for one round, not a fixture:
# they are named after the device and the day, they go stale the moment a
# surface changes, and a repository is not where a hundred PNGs of the same
# app belong. The findings go in the round's report and in docs/.
qa/

# Logs and local state
*.log
npm-debug.log*
yarn-error.log*
.env
.env.local

# Editors and OS
.DS_Store
.idea/
*.swp
