# Dependencies
node_modules/

# Build output
dist/
coverage/
*.tsbuildinfo

# Expo / continuous native generation — regenerate with `npx expo prebuild`
.expo/
apps/hermie/ios/
apps/hermie/android/

# Gradle's output for the local Expo modules, whose `android/` IS committed —
# so unlike the generated project above, only the build directories go.
apps/hermie/modules/*/android/build/
apps/hermie/modules/*/android/.gradle/
apps/hermie/modules/*/android/.cxx/

# Xcode build products, including the wrapped Mac bundle `npm run mac` writes
DerivedData/
apps/hermie/build/

# Logs and local state
*.log
npm-debug.log*
yarn-error.log*
.env
.env.local

# Editors and OS
.DS_Store
.idea/
*.swp

# Manual QA captures: simulator screenshots from a walk-through, kept out of the
# tree because they are evidence for one round, not an asset the app builds from.
qa/
