{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // This package SHIPS, so unlike every other workspace it emits JavaScript
    // rather than only declarations: the release zip and the Docker image both
    // run `dist/server`. CommonJS, because the emitted relative imports are
    // extensionless and Node's ESM loader refuses those — and because `ws` and
    // the tests are happier with it than a half-converted package would be.
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "emitDeclarationOnly": false,
    "lib": ["ES2023"],
    "types": ["node"],
    "outDir": "./dist/server",
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
