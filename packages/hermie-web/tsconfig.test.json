{
  // The tests, which the package's own tsconfig cannot check.
  //
  // `tsconfig.json` SHIPS this package — it emits the JavaScript the release
  // zip and the Docker image run — so it excludes `*.test.ts`, or the tests
  // would land in `dist/server` and the published tarball. The cost of that
  // exclusion was found in R10c: nothing type-checked the tests at all, so a
  // test could call a function with the wrong arguments and only vitest would
  // ever say so, at runtime, if that line happened to run.
  //
  // This project exists to close that hole and emits nothing. It is NOT a
  // composite project and is not referenced from the root `tsconfig.json`:
  // `tsc -b` would want to emit declarations for it, which is the thing being
  // avoided. The root `typecheck` script runs it as a second pass instead.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    // `vitest/globals` is not in use — every suite imports `describe`/`it`/
    // `expect` by name — so Node's types are still the whole surface.
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": []
}
